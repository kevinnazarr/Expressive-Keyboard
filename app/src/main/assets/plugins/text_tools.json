{
  "id": "builtin.text-tools",
  "name": "Alat Olah Teks",
  "version": "2.0",
  "author": "Expressive Keyboard",
  "description": "Transformasi teks terpilih atau kata terakhir: kapitalisasi, gaya font, case pemrograman, kutipan, dan matematika.",
  "icon": "✨",
  "actions": [
    { "title": "Hitung Rumus", "icon": "🧮", "type": "transform", "transform": "calc", "pinned": true },
    { "title": "HURUF BESAR", "icon": "🔠", "type": "transform", "transform": "upper" },
    { "title": "huruf kecil", "icon": "🔡", "type": "transform", "transform": "lower" },
    { "title": "Kapital Tiap Kata", "icon": "Aa", "type": "transform", "transform": "title" },
    { "title": "Awal kalimat", "icon": "A.", "type": "transform", "transform": "sentence" },
    { "title": "𝗕𝗼𝗹𝗱 (Tebal)", "icon": "𝗕", "type": "transform", "transform": "bold" },
    { "title": "𝘐𝘵𝘢𝘭𝘪𝘤 (Miring)", "icon": "𝘐", "type": "transform", "transform": "italic" },
    { "title": "x² (Superskrip)", "icon": "²", "type": "transform", "transform": "superscript" },
    { "title": "C̶o̶r̶e̶t̶", "icon": "S̶", "type": "transform", "transform": "strike" },
    { "title": "s p a s i", "icon": "␣", "type": "transform", "transform": "spaced" },
    { "title": "camelCase", "icon": "🐫", "type": "transform", "transform": "camel" },
    { "title": "snake_case", "icon": "🐍", "type": "transform", "transform": "snake" },
    { "title": "kebab-case", "icon": "🍢", "type": "transform", "transform": "kebab" },
    { "title": "«Petik Sudut»", "icon": "«»", "type": "transform", "transform": "wrap", "prefix": "«", "suffix": "»" },
    { "title": "\"Petik Ganda\"", "icon": "\"\"", "type": "transform", "transform": "wrap", "prefix": "\"", "suffix": "\"" },
    { "title": "(Tanda Kurung)", "icon": "()", "type": "transform", "transform": "wrap", "prefix": "(", "suffix": ")" },
    { "title": "sArKaZmE", "icon": "🧽", "type": "transform", "transform": "mock" },
    { "title": "Hapus Spasi Berlebih", "icon": "⇤⇥", "type": "transform", "transform": "trim", "scope": "text" },
    { "title": "Urutkan Baris", "icon": "↕️", "type": "transform", "transform": "sort_lines", "scope": "text" },
    { "title": "Hapus Baris Duplikat", "icon": "📑", "type": "transform", "transform": "unique_lines", "scope": "text" },
    { "title": "Balik Teks", "icon": "🔄", "type": "transform", "transform": "reverse" }
  ]
}
