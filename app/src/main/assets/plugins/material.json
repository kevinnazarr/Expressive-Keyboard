{
  "id": "builtin.material",
  "name": "Material 3 · Google",
  "version": "2.0",
  "author": "Expressive Keyboard",
  "description": "Tema bergaya Material 3 Google seperti Gboard: warna dinamis Material You, tombol bersudut melengkung, tombol fungsi bertingkat, dan saran teks elegan.",
  "icon": "🟣",
  "enabledByDefault": true,
  "skin": {
    "keyboard": {
      "corner": 20
    },
    "keys": {
      "*": {
        "radius": 8,
        "pressedRadius": 8,
        "press": "scale",
        "pressScale": 0.97
      },
      "space": {
        "radius": 8
      },
      "enter": {
        "shape": "pill"
      }
    },
    "popup": {
      "radius": 12
    },
    "chips": {
      "material": "none"
    },
    "buttons": {
      "material": "none"
    },
    "panel": {
      "radius": 18
    }
  }
}
