{
  "id": "builtin.datetime",
  "name": "Tanggal & Waktu (Date & Time)",
  "version": "1.0",
  "author": "Expressive Keyboard",
  "description": "Menyisipkan tanggal dan waktu terkini, singkatan :date, :time, :now",
  "icon": "📅",
  "actions": [
    { "title": "Hari Ini", "icon": "📅", "type": "insert", "text": "{date}" },
    { "title": "Jam Sekarang", "icon": "🕒", "type": "insert", "text": "{time}" },
    { "title": "Tanggal & Waktu", "icon": "🗓️", "type": "insert", "text": "{datetime}" },
    { "title": "Format ISO", "icon": "#", "type": "insert", "text": "{date:yyyy-MM-dd}" },
    { "title": "Nama Hari", "icon": "📆", "type": "insert", "text": "{date:EEEE}" }
  ],
  "shortcuts": {
    ":date": "{date}",
    ":time": "{time}",
    ":now": "{datetime}"
  }
}
